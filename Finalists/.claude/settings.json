{
  "permissions": {
    "allow": [
      "Bash(Rscript:*)",
      "Bash(quarto render:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git branch:*)",
      "Bash(git checkout -b:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)"
    ],
    "deny": [
      "Bash(git push origin main:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)",
      "Bash(git merge:*)",
      "Bash(git rebase:*)",
      "Bash(rm -rf:*)",
      "Read(**/.Renviron)",
      "Edit(**/.Renviron)",
      "Edit(**/data/raw/**)",
      "Write(**/data/raw/**)",
      "Edit(**/.RData)",
      "Read(**/.RData)"
    ]
  }
}
