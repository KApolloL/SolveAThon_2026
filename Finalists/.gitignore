# Generated; rebuild with the commands in README.md. A teammate running "git add -A" must never
# commit toy-data or stale outputs. To keep a final deliverable: git add -f outs/<file> (Kent only).
outs/*
!outs/figures/
!outs/.gitkeep
data/processed/ranking.csv
data/processed/profile/
data/cache/llm/
.quarto/
*_files/

