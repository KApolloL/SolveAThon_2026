{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["AGENTS.md"],
  "permission": {
    "edit": "ask",
    "bash": {
      "*": "ask",
      "Rscript *": "allow",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git push*": "allow",
      "git merge*": "deny",
      "git rebase*": "deny",
      "git reset --hard*": "deny",
      "rm -rf*": "deny"
    }
  }
}
